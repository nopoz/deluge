#!/command/with-contenv sh
# Chown /config ONLY. Download and media mounts are deliberately untouched: a
# recursive chown across a media library would be slow and destructive.
set -e

groupmod -o -g "${PGID:-1000}" deluge
usermod  -o -u "${PUID:-1000}" -g "${PGID:-1000}" deluge

mkdir -p /config /run/deluged-temp
chown -R deluge:deluge /config
chown deluge:deluge /run/deluged-temp

# One unconditional line, so an operator running at --loglevel error still gets
# confirmation of what started and as whom. Deluge itself says nothing below
# warning level, which reads as a container that failed silently.
echo "deluge: $(deluged --version | head -1), uid=$(id -u deluge) gid=$(id -g deluge) umask=${UMASK_SET:-${UMASK:-022}}"
